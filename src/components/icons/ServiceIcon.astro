---
import { 
  Heart, 
  Activity, 
  Stethoscope, 
  Microscope, 
  Baby, 
  Eye, 
  Brain, 
  Pill, 
  Wind, 
  Smile,
  type IconNode
} from '@lucide/astro';

interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;

const iconMap: Record<string, IconNode> = {
  'heart': Heart,
  'activity': Activity,
  'stethoscope': Stethoscope,
  'microscope': Microscope,
  'baby': Baby,
  'eye': Eye,
  'brain': Brain,
  'pill': Pill,
  'wind': Wind,
  'smile': Smile,
};

const IconComponent = iconMap[name] || Heart;
---

<IconComponent class={className} />