---
import Eyebrow from '@components/ui/Eyebrow.astro';
import { getPaddingClass, getBackgroundColor, getTextColor } from '@utils/styleUtils';
import type { PaddingSize, ThemeColor } from '@utils/styleUtils';

const getIconSvg = (iconName: string): string[] => {
  const icons: Record<string, string[]> = {
    'heart': [
      'M19.5 12.572l-7.097 4.27-1.99-2.14L6 11.572l7.097-4.27 1.99 2.14 4.413 1.43z'
    ],
    'activity': [
      'M22 12h-4l-3 9 9 3-3-9h4'
    ],
    'stethoscope': [
      'M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3',
      'M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4',
      'M20 10'
    ],
    'brain': [
      'M12 5a3 3 0 1 0 0 6 3 3 0 0 0 0-6z M5 12a7 7 0 0 0 14 0'
    ],
    'eye': [
      'M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z'
    ],
    'ear': [
      'M6 10a6 6 0 1 0 12 0 6 6 0 0 0-12 0z M12 4v6 M9 7h6'
    ],
    'pill': [
      'M10.5 20.5l10-10.5-10.5-10.5'
    ],
    'baby': [
      'M9 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M15 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M12 3v4 M6 11a4 4 0 0 1 4-4h4a4 4 0 0 1 0 8H10a4 4 0 0 1-4-4z'
    ],
    'microscope': [
      'M6 18h8 M3 22h18 M14 22a7 7 0 1 0-12-7 M14 2v4 M10 2v4 M10 6h4'
    ],
    'wind': [
      'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M6 12c0-3 2-5 6-5s6 2 6 5'
    ],
    'smile': [
      'M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z M8 14s1.5 2 4 2 4-2 4-2 M9 10h.01 M15 10h.01'
    ],
  };
  return icons[iconName] || icons['activity'];
};

export interface Props {
    content: {
        eyebrow?: string;
        title?: string;
        description?: string;
        button?: {
            text: string;
            link: string;
            variant?: 'primary' | 'secondary' | 'ghostLight' | 'ghostDark';
        };
        features: { iconName: string; title: string; description: string }[];
    };
    background?: ThemeColor;
    padding?: PaddingSize;
    paddingTop?: PaddingSize;
    paddingBottom?: PaddingSize;
}

const {
    content: {
        eyebrow,
        title,
        description,
        button,
        features
    },
    background = 'base'
} = Astro.props;

const bgColor = getBackgroundColor(background);
const textColor = getTextColor(background);
const paddingClass = getPaddingClass({ 
    padding: Astro.props.padding,
    paddingTop: Astro.props.paddingTop,
    paddingBottom: Astro.props.paddingBottom 
});
---

<section class:list={["relative", bgColor, paddingClass]}>
    <div class="site-container px-4">
        {(title || description) && (
            <div class="text-center mb-16 max-w-3xl mx-auto">
                {eyebrow && (
                    <Eyebrow 
                        text={eyebrow} 
                        background={background} 
                    />
                )}
                {title && (
                    <h2 class:list={[textColor]}>
                        {title}
                    </h2>
                )}
                {description && (
                    <p class:list={["mt-4", textColor, "opacity-90"]}>
                        {description}
                    </p>
                )}
                {button && (
                    <div class="mt-8">
                        <a
                            href={button.link}
                            class:list={[
                                "inline-flex items-center justify-center rounded-lg px-6 py-3 text-base font-medium transition-colors",
                                "bg-primary text-white hover:bg-primary-dark",
                            ]}
                        >
                            {button.text}
                        </a>
                    </div>
                )}
            </div>
        )}

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-auto-fit gap-8 auto-rows-fr">
            {features.map((feature) => (
                <div 
                    class:list={[
                        "p-6 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300",
                        background === 'dark' ? 'bg-background-base/10' : 'bg-white',
                        "flex flex-col"
                    ]}
                >
                    <div class:list={[
                        "w-12 h-12 flex items-center justify-center rounded-lg mb-4",
                        "bg-primary"
                    ]}>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                          {getIconSvg(feature.iconName).map(path => (
                            <path d={path} />
                          ))}
                        </svg>
                    </div>
                    <h3 class:list={["text-h4 mb-2", textColor]}>
                        {feature.title}
                    </h3>
                    <p class:list={["text-base", textColor, "opacity-90"]}>
                        {feature.description}
                    </p>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .grid-cols-auto-fit {
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
</style>
