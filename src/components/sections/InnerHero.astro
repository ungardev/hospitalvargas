---
interface HeroContent {
    title: string;
    description?: string;
}

interface Props {
    content: HeroContent;
}

const { content } = Astro.props;
---

<section class="w-full border-b pt-24 pb-12 relative bg-primary">
    <div class="site-container mx-auto px-4 relative z-10">
        <div>
            <h1 class="text-white">{content.title}</h1>
            {content.description && <p class="subtitle text-white">{content.description}</p>}
        </div>
    </div>
</section>
