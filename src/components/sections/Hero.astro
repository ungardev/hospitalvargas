---
import Button from '@components/ui/Button.astro';

interface HeroContent {
    title: string;
    description: string;
    buttons?: {
        text: string;
        link: string;
        variant?: 'primary' | 'secondary' | 'ghostLight' | 'ghostDark';
        target?: string;
    }[];
}

interface Props {
    content: HeroContent;
}

const { content } = Astro.props;
---

<section class="header-offset relative min-h-[85vh] flex items-center justify-center">
    <img 
        src="/images/fachada-hero.jpg" 
        alt="Hospital Vargas de Caracas" 
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-br from-primary/50 to-primary-dark/70"></div>
    <div class="site-container mx-auto px-4 relative z-10 flex flex-col md:items-center md:justify-center md:text-center animate-fade-in">
        <h1 class="text-white text-balance">{content.title}</h1>
        <p class="text-white mt-4 text-lg md:text-xl text-balance max-w-3xl">{content.description}</p>
        {content.buttons && content.buttons.length > 0 && (
            <div class="flex flex-wrap gap-4 mt-8 justify-center">
                {content.buttons.map((button) => (
                    <Button
                        href={button.link}
                        target={button.target || '_self'}
                        variant={button.variant || 'primary'}
                    >
                        {button.text}
                    </Button>
                ))}
            </div>
        )}
    </div>
</section>
