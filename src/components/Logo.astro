---
interface Props {
    variant?: 'header' | 'footer' | 'dark';
}

const { variant = 'header' } = Astro.props;

const getLogoClass = () => {
    switch (variant) {
        case 'header':
            return 'text-header-logo';
        case 'footer':
            return 'text-footer-logo';
        case 'dark':
            return 'text-body-base';
        default:
            return 'text-body-base';
    }
};
---

<a href="/" class:list={['flex items-center gap-2', getLogoClass()]}>
    <img 
        src="/images/logo-vargas.png" 
        alt="Hospital Vargas" 
        class="h-10 md:h-12 w-auto object-contain"
        loading="eager"
    />
    <span class="text-lg md:text-xl font-bold tracking-wide text-primary">HOSPITAL VARGAS</span>
</a>
