---
import Layout from '@layouts/Layout.astro';
import InnerHero from '@components/sections/InnerHero.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import { services, serviceCategories } from '@data/services';

const heroContent = {
    title: 'Servicios Médicos',
    description: '35+ especialidades médicas al servicio de los venezolanos'
};

const getServiceIcon = (iconName: string): string[] => {
  const icons: Record<string, string[]> = {
    'heart': [
      'M19.5 12.572l-7.097 4.27-1.99-2.14L6 11.572l7.097-4.27 1.99 2.14 4.413 1.43z'
    ],
    'activity': [
      'M22 12h-4l-3 9 9 3-3-9h4'
    ],
    'stethoscope': [
      'M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3',
      'M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4',
      'M20 10'
    ],
    'brain': [
      'M12 5a3 3 0 1 0 0 6 3 3 0 0 0 0-6z M5 12a7 7 0 0 0 14 0'
    ],
    'eye': [
      'M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z'
    ],
    'ear': [
      'M6 10a6 6 0 1 0 12 0 6 6 0 0 0-12 0z M12 4v6 M9 7h6'
    ],
    'pill': [
      'M10.5 20.5l10-10.5-10.5-10.5'
    ],
    'baby': [
      'M9 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M15 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M12 3v4 M6 11a4 4 0 0 1 4-4h4a4 4 0 0 1 0 8H10a4 4 0 0 1-4-4z'
    ],
    'microscope': [
      'M6 18h8 M3 22h18 M14 22a7 7 0 1 0-12-7 M14 2v4 M10 2v4 M10 6h4'
    ],
    'wind': [
      'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M6 12c0-3 2-5 6-5s6 2 6 5'
    ],
    'smile': [
      'M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z M8 14s1.5 2 4 2 4-2 4-2 M9 10h.01 M15 10h.01'
    ],
  };
  return icons[iconName] || icons['activity'];
};

const groupedServices = serviceCategories.map(cat => ({
    category: cat,
    services: services.filter(s => s.category === cat)
}));
---

<Layout title="Servicios | Hospital José María Vargas" description="35+ especialidades médicas del Hospital José María Vargas">
    <InnerHero content={heroContent} />
    
    <section class="py-base bg-background">
        <div class="site-container px-4">
            <div class="text-center mb-8">
                <Eyebrow text="ESPECIALIDADES" background="base" />
                <h2 class="text-h2">Nuestros Servicios</h2>
                <p class="text-body-base mt-4 max-w-2xl mx-auto">
                    El Hospital Vargas ofrece más de 35 especialidades médicas con equipamiento de alta tecnología,
                    incluyendo laparoscopia, broncofibroscopía, ecodoppler, ecocardiograma y diagnóstico por imagen avanzado.
                </p>
            </div>

            <div class="flex flex-wrap gap-4 justify-center mb-12">
                <button 
                    class="filter-btn active px-4 py-2 rounded-md border border-primary bg-primary text-white transition-default"
                    data-category="all"
                >
                    Todas
                </button>
                {serviceCategories.map(cat => (
                    <button 
                        class="filter-btn px-4 py-2 rounded-md border border-black bg-white text-body-base hover:bg-primary hover:text-white transition-default"
                        data-category={cat}
                    >
                        {cat}
                    </button>
                ))}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="services-grid">
                {services.map(service => (
                    <div 
                        class="service-card p-6 rounded-lg border border-black bg-background/90 card-interactive"
                        data-category={service.category}
                    >
                        <div class="w-12 h-12 flex items-center justify-center rounded-lg mb-4 bg-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                                {getServiceIcon(service.iconName).map(path => (
                                    <path d={path} />
                                ))}
                            </svg>
                        </div>
                        <h3 class="text-h4 mb-2">{service.name}</h3>
                        <span class="text-sm text-primary font-medium">{service.category}</span>
                        <p class="text-body-base text-sm mt-2 opacity-90">{service.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>
</Layout>

<script>
    const filterBtns = document.querySelectorAll('.filter-btn');
    const serviceCards = document.querySelectorAll('.service-card');

    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const category = btn.getAttribute('data-category');
            
            filterBtns.forEach(b => {
                b.classList.remove('active', 'bg-primary', 'text-white');
                b.classList.add('bg-white', 'text-body-base');
            });
            btn.classList.add('active', 'bg-primary', 'text-white');
            btn.classList.remove('bg-white', 'text-body-base');

            serviceCards.forEach(card => {
                if (category === 'all' || card.getAttribute('data-category') === category) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        });
    });
</script>
