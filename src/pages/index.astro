---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/sections/Hero.astro';
import SplitPanel from '@components/sections/SplitPanel.astro';
import Features from '@components/sections/Features.astro';
import Stats from '@components/sections/Stats.astro';
import { services } from '@data/services';
import { hospitalStats } from '@data/history';
import { config } from '@data/config';

const seoTitle = config.seo.title;
const seoDescription = config.seo.description;

const heroContent = {
    title: config.siteInfo.name,
    description: 'Segundo centro de salud más importante de Venezuela. Más de 134 años formando profesionales de la medicina y brindando atención de calidad a los caraqueños.',
    buttons: [
        {
            text: 'Ver Servicios',
            link: '/servicios',
            target: '_self'
        },
        {
            text: 'Conocer Más',
            link: '/historia',
            target: '_self'
        }
    ]
};

const homepageFeatures = services.slice(0, 6).map(s => ({
    iconName: s.iconName,
    title: s.name,
    description: s.description
}));

const featuresSection = {
    eyebrow: 'SERVICIOS',
    title: 'Especialidades Médicas',
    description: 'El Hospital Vargas ofrece 35+ especialidades médicas con equipamiento de alta tecnología.',
    features: homepageFeatures
};

const statsContent = {
    eyebrow: 'IMPACTO',
    stats: [
        { value: hospitalStats.yearsOfHistory, label: 'Años de Historia' },
        { value: hospitalStats.specialties, label: 'Especialidades Médicas' },
        { value: hospitalStats.postgradPrograms, label: 'Programas de Postgrado' },
        { value: hospitalStats.influenceArea.replace(' mil habitantes', 'K+'), label: 'Población Atendida' }
    ]
};

const historySection = {
    eyebrow: 'NUESTRA HISTORIA',
    headline: 'Dr. José María Vargas',
    description: 'El Hospital José María Vargas fue fundado en la ciudad de Caracas el 5 de julio de 1891, nombrado así en honor al ilustre médico venezolano del cual lleva su nombre. Ha ofrecido más de 134 años de formación académica y funcionamiento continuo al servicio de los venezolanos con un personal paramédico y médicos especialistas de renombre.\n\nEste hospital tipo 4 tiene un área de influencia de más de 400 mil habitantes y es centro de referencia nacional, atendiendo pacientes de todos los rincones del país. Es el segundo hospital más importante del Ministerio del Poder Popular para la Salud, después del Hospital Universitario de Caracas.'
}
---

<Layout title={seoTitle} description={seoDescription}>
    <Hero content={heroContent} />
    <Features content={featuresSection} padding="small" background="light" />
    <Stats content={statsContent} background="dark" padding="small" />
    <SplitPanel content={historySection} imagePosition="right" background="light" padding="small" />
</Layout>
